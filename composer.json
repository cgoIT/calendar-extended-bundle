{
  "name": "cgoit/calendar-extended-bundle",
  "type": "contao-bundle",
  "description": "Contao 5 calendar extension bundle. Better recurring events and exceptions.",
  "keywords": [
    "contao",
    "fullcalendar",
    "calendar",
    "events",
    "exceptions",
    "registration",
    "vacations"
  ],
  "version": "3.0.1",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Kester Mielke",
      "email": "kester.mielke@posteo.de"
    },
    {
      "name": "Carsten Götzinger",
      "homepage": "https://github.com/cgoIT"
    }
  ],
  "support": {
    "issues": "https://github.com/cgoIT/calendar-extended-bundle/issues",
    "source": "https://github.com/cgoIT/calendar-extended-bundle"
  },
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "contao/core-bundle": "^5.3",
    "contao/calendar-bundle": "^5.3",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/routing": "^6.4 || ^7.0",
    "symfony/security-bundle": "^6.4 || ^7.0",
    "symfony/event-dispatcher": "^6.4 || ^7.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "doctrine/dbal": "^3.3 || ^4.0",
    "menatwork/contao-multicolumnwizard-bundle": "^3.6"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "phpunit/phpunit": "^11.5",
    "terminal42/contao-build-tools": "dev-main",
    "twig/twig": "^3.0"
  },
  "suggest": {
    "cgoit/contao-calendar-ical-bundle": "For importing events from iCal sources.",
    "inspiredminds/contao-event-registration": "For registration to events use this bundle."
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "Cgoit\\CalendarExtendedBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cgoit\\CalendarExtendedBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "php-http/discovery": true,
      "contao-community-alliance/composer-plugin": true,
      "contao/manager-plugin": true,
      "terminal42/contao-build-tools": true
    },
    "sort-packages": true
  },
  "extra": {
    "contao-manager-plugin": "Cgoit\\CalendarExtendedBundle\\ContaoManager\\Plugin"
  },
  "scripts": {
    "all": [
      "@fix-tools",
      "@tests"
    ],
    "tests": "phpunit",
    "coverage": "@php -d extension=pcov -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-filter src --coverage-html build/coverage"
  }
}

<?php
$js = static fn ($value): string => json_encode($value, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
?>
<div id="calendar-<?= (int) $this->moduleId ?>" class="calendar" style="margin:auto 25px;"></div>

<script type="application/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        const calendarEl = document.getElementById('calendar-<?= (int) $this->moduleId ?>');

        const calendar = new FullCalendar.Calendar(calendarEl, {
            locale: <?= $this->locale ?>,
            initialDate: <?= $js($this->initialDate) ?>,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,dayGridDay,listMonth'
            },
            navLinks: true,
            editable: false,
            dayMaxEvents: true,
            timeZone: 'local',
            initialView: <?= $js($this->initialView) ?>,
            weekNumbers: <?= $js((bool) $this->weekNumbers) ?>,
            weekNumberCalculation: 'ISO',
            firstDay: <?= $js((int) $this->firstDay) ?>,
            <?php if (!empty($this->businessHours)): ?>
            businessHours: <?= $this->businessHours ?>,
            <?php endif; ?>
            eventSources: [{
                url: <?= $js($this->url) ?>,
                method: 'POST',
                extraParams: function () {
                    return {
                        REQUEST_TOKEN: <?= $js($this->requestToken) ?>,
                    }
                },
                failure: function () {
                    alert(<?= $js($this->fetch_error) ?>);
                }
            }],

            // Render the font-awesome icon if exists
            eventDidMount: function (info) {
                if (info.event.title) {
                    info.el.setAttribute('title', info.event.title);
                }

                if (info.event.extendedProps.calendarId) {
                    info.el.classList.add('cal-' + info.event.extendedProps.calendarId);
                }

                const timeElement = info.el.querySelector('.fc-event-time');
                if (info.event.extendedProps.editable && timeElement) {
                    const icon = document.createElement('i');
                    icon.classList.add('fa');
                    icon.classList.add('fa-pencil-square-o');
                    icon.style.paddingRight = '5px';
                    timeElement.insertBefore(icon, timeElement.firstChild);
                }
                if (info.event.extendedProps.icon && timeElement) {
                    const icon = document.createElement('i');
                    icon.classList.add('fa');
                    icon.classList.add(info.event.extendedProps.icon);
                    icon.style.paddingRight = '5px';
                    timeElement.insertBefore(icon, timeElement.firstChild);
                }
            },
        });

        calendar.render();

    });

</script>

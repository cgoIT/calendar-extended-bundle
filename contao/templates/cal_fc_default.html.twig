{#
    FullCalendar container. The configuration is read by bundles/cgoitcalendarextended/js/fullcalendar.js
    from the data attribute, so no inline script is required.

    Variables:
      moduleId  int    ID of the frontend module
      config    array  FullCalendar options (locale, initialDate, initialView, weekNumbers, firstDay,
                       businessHours, url, requestToken, fetchError)
#}
{# FullCalendar injects a style element, which needs the style nonce of the Content Security Policy #}
<meta name="csp-nonce" content="{{ csp_nonce('style-src') }}">
{# The scripts are loaded by fullcalendar.js once the nonce above exists, FullCalendar reads it only on load #}
<div id="calendar-{{ moduleId }}" class="calendar" data-calendar-config="{{ config|json_encode|e('html_attr') }}" data-calendar-scripts="{{ [asset('bundles/cgoitcalendarextended/fullcalendar-6.1.20/dist/index.global.min.js'), asset('bundles/cgoitcalendarextended/fullcalendar-6.1.20/packages/core/locales-all.global.min.js')]|json_encode|e('html_attr') }}"></div>
